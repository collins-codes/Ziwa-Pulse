{
  "name": "Subscriber",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 120,
      "description": "Subscriber's name"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+254[17][0-9]{8}$",
      "description": "Subscriber's Kenyan phone number in E.164 format"
    },
    "beaches": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Beach record IDs the subscriber wants alerts for"
    },
    "role": {
      "type": "string",
      "enum": [
        "Fisher",
        "BMU official",
        "Boat operator",
        "Fish trader",
        "Harvester",
        "Briquette or biogas maker",
        "Other"
      ],
      "description": "Subscriber's community or professional role"
    },
    "language": {
      "type": "string",
      "enum": ["en", "sw"],
      "default": "en",
      "description": "Preferred language for hyacinth alert messages"
    }
  },
  "required": ["name", "phone", "beaches", "role"],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

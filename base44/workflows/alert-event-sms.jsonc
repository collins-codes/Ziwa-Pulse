{
  "name": "Alert Event SMS",
  "description": "Prepares dry-run SMS messages when a beach alert event is created",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "AlertEvent",
      "events": ["create"]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alert_event_sms",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "prepare_alert_messages": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendAlert",
            "args": {
              "alertEventId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Prepare dry-run SMS messages",
            "description": "No SMS provider is called"
          }
        }
      }
    ]
  }
}
